{
  "manifest_version": 3,
  "name": "Essential Cookie Selector",
  "version": "1.0",
  "description": "Automatically selects essential cookies on webpages.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Smart Cookie Selector",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}